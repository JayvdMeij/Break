---
import SectionHeader from './SectionHeader.astro';
import { capabilities } from '../data/site';
---

<section id="capabilities" class="capabilities">
  <div class="head" data-reveal>
    <div>
      <SectionHeader number="02" label="CAPABILITIES" />
      <h2 class="title">WHAT WE MAKE</h2>
    </div>
    <p class="note">Six disciplines, one system. Most engagements combine three of them.</p>
  </div>

  <ul class="rows">
    {
      capabilities.map((item) => (
        <li class="row" data-reveal data-row>
          <span class="number">{item.number}</span>
          <h3 class="name">{item.title}</h3>
          <p class="copy">{item.description}</p>
          <span class="duration">{item.duration}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .capabilities {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: var(--rule);
    scroll-margin-top: var(--nav-h);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .title {
    margin-top: 1.2rem;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 7rem);
    line-height: 0.9;
  }

  .note {
    max-width: 20rem;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink-70);
  }

  .rows {
    border-top: var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1.1fr) minmax(0, 1.4fr) 7rem;
    gap: 2rem;
    align-items: center;
    padding: 1.6rem 1rem;
    border-bottom: var(--rule);
    transition:
      background 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .row:hover,
  .row:focus-within {
    background: var(--ink);
    color: var(--paper);
  }

  .number {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .name {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.6vw, 3.4rem);
    line-height: 0.95;
  }

  .copy {
    font-size: 1rem;
    line-height: 1.5;
  }

  .duration {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: right;
    opacity: 0.7;
  }

  @media (max-width: 60rem) {
    .capabilities {
      min-height: 0;
    }

    /* Number + title on top, description and duration below. */
    .row {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 0.6rem 1.2rem;
      padding: 1.4rem 0;
    }

    .copy {
      grid-column: 2 / -1;
    }

    .duration {
      grid-column: 3;
      grid-row: 1;
      align-self: center;
    }
  }
</style>
