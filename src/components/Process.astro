---
import GridOverlay from './GridOverlay.astro';
import SectionHeader from './SectionHeader.astro';
import { processSteps } from '../data/site';
---

<section id="process" class="process">
  <GridOverlay tone="dark" contained />

  <div class="inner">
    <SectionHeader number="04" label="PROCESS" data-reveal />

    <h2 class="title" data-reveal>FOUR STEPS.<br />NO SURPRISES.</h2>

    <ol class="steps">
      {
        processSteps.map((item, i) => (
          <li class:list={['step', { first: i === 0 }]} data-reveal>
            <span class="label">{item.step}</span>
            <h3 class="name">{item.title}</h3>
            <p class="copy">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--dark);
    color: var(--paper);
    scroll-margin-top: var(--nav-h);
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.4rem, 9vw, 9.5rem);
    line-height: 0.88;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2.5rem;
  }

  .step {
    border-top: 5px solid var(--paper-30);
    padding-top: 1.2rem;
  }

  .step.first {
    border-top-color: var(--accent);
  }

  .label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .name {
    margin-top: 0.7rem;
    font-family: var(--display);
    font-weight: 400;
    font-size: 2.4rem;
    line-height: 1;
  }

  .copy {
    margin-top: 0.8rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--paper-72);
  }

  @media (max-width: 60rem) {
    .process {
      min-height: 0;
    }

    .inner {
      gap: 2.2rem;
    }
  }
</style>
