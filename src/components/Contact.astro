---
import SectionHeader from './SectionHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { site } from '../data/site';
---

<section id="contact" class="contact">
  <SectionHeader number="06" label="CONTACT" data-reveal />

  <h2 class="title" data-reveal>TELL US WHAT<br />NEEDS <span class="accent">BREAKING.</span></h2>

  <div class="body">
    <p class="lede" data-reveal>
      Send the brief, the deadline and the budget range. You get an answer within two working days,
      and a first call with the people who will do the work.
    </p>

    <a class="mail" href={`mailto:${site.email}`} data-reveal>
      <span>{site.email.toUpperCase()}</span>
      <span aria-hidden="true">→</span>
    </a>

    <ul class="details" data-reveal>
      <li>
        <span class="pip" aria-hidden="true">✆</span>
        <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </li>
      <li>
        <span class="pip" aria-hidden="true">⌂</span>
        <span>{site.address}</span>
      </li>
    </ul>
  </div>

  <SiteFooter />
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: var(--section-y) var(--gutter) 3rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    scroll-margin-top: var(--nav-h);
  }

  .title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.6rem, 11.5vw, 12rem);
    line-height: 0.86;
  }

  .accent {
    color: var(--accent);
  }

  .body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2.5rem 4rem;
    align-items: end;
    border-top: var(--rule);
    padding-top: 2.5rem;
  }

  .lede {
    max-width: 34rem;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .mail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: var(--ink);
    color: var(--paper);
    padding: 1.6rem 1.8rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    transition: background 0.25s var(--ease);
  }

  .mail:hover {
    background: var(--accent);
  }

  .details {
    display: grid;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .details li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .details a {
    transition: color 0.2s var(--ease);
  }

  .details a:hover {
    color: var(--accent);
  }

  .pip {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    font-size: 0.6rem;
    line-height: 1;
  }

  @media (max-width: 60rem) {
    .contact {
      min-height: 0;
      gap: 2.2rem;
    }
  }
</style>
