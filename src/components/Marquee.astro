---
import { marqueeItems } from '../data/site';
---

<div class="marquee">
  <div class="track">
    {
      [0, 1].map((copy) => (
        <ul class="run" aria-hidden={copy === 1 ? 'true' : undefined}>
          {marqueeItems.map((item) => (
            <>
              <li>{item}</li>
              <li class="star" aria-hidden="true">
                ✳
              </li>
            </>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    background: var(--dark);
    color: var(--paper);
    padding: 1.6rem 0;
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  .run {
    display: flex;
    gap: 3rem;
    padding-right: 3rem;
    font-family: var(--display);
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .star {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
